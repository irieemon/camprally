# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Generated by scripts/build-search-index.mjs (wired into prebuild/predev).
# Derived data from src/data/articles.ts, not a source file — same kind of
# artifact as .next/, regenerated on every build so it can never go stale.
/public/search-index.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# launchd job logs — runtime output, not state. These live under state/ so the
# plist can write them without extra setup, but committing them would make the
# working tree dirty on every run and the cycle refuses to run dirty. The job
# would block on its own logs forever.
state/cycle.log
state/cycle.err.log

# The run lock is liveness, not state. The heartbeat commits state/ wholesale,
# so a held lock was being committed and then showing as deleted the moment the
# run exited — churn in history, and worse, a lock file that could arrive on
# another checkout naming a pid that means nothing there.
state/cycle.lock

# Never commit subscriber data. The repo is public. The subscribe route posts
# straight to Beehiiv and keeps no local list, but this guards against a future
# implementation quietly writing one here.
subscribers.json
subscribers*.json
